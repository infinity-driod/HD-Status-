# From Meta developer dashboard > WhatsApp > API Setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# The business/test number, digits only with country code (no + or spaces)
WA_BUSINESS_NUMBER=
# Any random string; you paste the same one into Meta's webhook settings
VERIFY_TOKEN=change-me
# Meta app > Settings > Basic > App secret (verifies webhook calls)
APP_SECRET=
# Optional: protects the upload page. Leave empty for local use.
APP_PASSWORD=
GRAPH_VERSION=v23.0
PORT=3000
